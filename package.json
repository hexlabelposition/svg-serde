{
  "name": "svg-serde",
  "version": "0.2.0",
  "description": "Lightweight, type-safe SVG serialization and deserialization for JavaScript and TypeScript",
  "license": "MIT",
  "author": {
    "name": "Vladyslav Kudriashov",
    "email": "hexlabelposition@gmail.com",
    "url": "https://hexlabelposition.dev/"
  },
  "keywords": [
    "svg",
    "xml",
    "parser",
    "serializer",
    "ast",
    "round-trip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlabelposition/svg-serde.git"
  },
  "homepage": "https://github.com/hexlabelposition/svg-serde#readme",
  "bugs": {
    "url": "https://github.com/hexlabelposition/svg-serde/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "generate": "bun scripts/generate-known-names.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc && tsc -p test && tsc -p scripts",
    "test": "vitest run --project node",
    "test:bun": "bun --bun vitest run --project node",
    "test:browser": "vitest run --project 'browser (*)'",
    "test:watch": "vitest --project node",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@tabler/icons": "^3.49.0",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.5",
    "bootstrap-icons": "^1.13.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "jiti": "^2.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "simple-icons": "^16.35.0",
    "svg-element-attributes": "^2.2.0",
    "svg-tag-names": "^3.0.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
